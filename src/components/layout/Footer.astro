---
import { Image } from "astro:assets";

import malvinasImg from "../../assets/Malvinas.png";
import instagramIcon from "../../assets/Instagram.svg"
import gmailIcon from "../../assets/Gmail.svg"
import whatsappIcon from "../../assets/Whatsapp.svg"
---

<footer id="contacto" class="w-full bg-[#14141C] text-textFooter py-12 lg:py-16 px-4 font-gothic" aria-label="Pie de página">
    <div class="max-w-6xl mx-auto flex flex-col items-center gap-6">

      <!-- REDES -->
       <div class="flex flex-col gap-3">
        <a href="https://www.instagram.com/stylosbarber1/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 hover:opacity-80 transition-transform duration-200 hover:scale-105">
          <span class="w-8 flex justify-center"><Image src={instagramIcon} alt="Instagram de Stylo's Barber" class="w-6 h-6 transition-transform duration-200" /></span>
          <span class="text-m">@stylosbarber1</span> </a>
        <a href="tel:+541132303565" class="flex items-center gap-3 hover:opacity-80 transition-transform duration-200 hover:scale-105">
        <span class="w-8 flex justify-center"><Image src={whatsappIcon} alt="WhatsApp de Stylo's Barber" class="w-6 h-6 transition-transform duration-200" /></span><span class="text-m">11 3230 3565</span> </a>
        <a href="mailto:stylos.barber1@gmail.com?subject=Consulta%20desde%20la%20web" target="_blank" rel="noopener noreferrer"  class="flex items-center gap-3 hover:opacity-80 transition-transform duration-200 hover:scale-105">
          <span class="w-8 flex justify-center"> <Image src={gmailIcon} alt="Correo electrónico de Stylo's Barber" class="w-6 h-6 transition-transform duration-200" /></span><span class="text-m">stylos.barber1@gmail.com</span> </a>
      </div>

      <!-- MARCA -->
      <p class="text-sm opacity-80 text-center">
        © {new Date().getFullYear()} Stylo's Barber
      </p>

      <!-- MALVINAS -->
       <Image
        src={malvinasImg}
        alt="Las Malvinas son Argentinas"
        class="w-12 opacity-80"
       />
    </div>
  </footer>