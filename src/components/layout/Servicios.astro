---
import Button from "../Button.astro"
import CardServicios from "../CardServicios.astro"
import { FRESHA_BOOKING_URL } from "../../config/site"
---
<section id="servicios" class="w-full py-16 lg:py-28 text-center font-gothic" aria-label="Servicios ofrecidos" data-analytics-section-view>
    <div class="max-w-6xl mx-auto px-4">
        <div class="mb-10 lg:mb-16 opacity-0" data-animate>
            <span class="text-accent text-xs font-semibold tracking-widest uppercase mb-3 block">Servicios</span>
            <h2 class="font-bold text-3xl sm:text-4xl lg:text-5xl xl:text-6xl uppercase text-textLight">Servicios</h2>
            <div class="w-12 h-1 bg-accent rounded-full mx-auto mt-4"></div>
        </div>

        <div class="grid lg:grid-cols-3 gap-6 lg:gap-8 mb-12 lg:mb-16 opacity-0" data-animate style="animation-delay: 100ms">
            <CardServicios
                serviceTitle="Corte"
                servicePrice="$17.000"
                serviceText= "Corte masculino adaptado a tu estilo, tipo de pelo y mantenimiento habitual."
            />
            <CardServicios
                serviceTitle="Barba"
                servicePrice="$12.000"
                serviceText= "Perfilado y arreglo de barba según largo, forma del rostro y estilo buscado."
            />
            <CardServicios
                serviceTitle="Combo"
                servicePrice="$22.000"
                serviceText= "Servicio integral para resolver corte y barba en una misma visita."
            />
        </div>

        <Button
            buttonText="Reservá online"
            buttonLink={FRESHA_BOOKING_URL}
            classString="inline-block text-center text-base sm:text-lg lg:text-xl py-4 px-8 w-full max-w-[360px] border-2 border-accent text-accent hover:bg-accent hover:text-white transition-all duration-300 rounded-xl font-bold uppercase"
            location="servicios"
        />
    </div>
  </section>