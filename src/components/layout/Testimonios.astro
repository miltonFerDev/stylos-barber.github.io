---
import CardTestimonios from "../CardTestimonios.astro"
---
<section id="testimonios" class="w-full py-16 lg:py-28 text-center font-gothic" aria-label="Testimonios de clientes">
    <div class="max-w-6xl mx-auto px-4">
        <div class="mb-10 lg:mb-16 opacity-0" data-animate>
            <span class="text-accent text-xs font-semibold tracking-widest uppercase mb-3 block">Testimonios</span>
            <h2 class="font-bold text-3xl sm:text-4xl lg:text-5xl xl:text-6xl uppercase text-textLight">Lo que dicen nuestros clientes</h2>
            <div class="w-12 h-1 bg-accent rounded-full mx-auto mt-4"></div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8 opacity-0" data-animate style="animation-delay: 100ms">
            <CardTestimonios
                name="Juan Carlos"
                quote="Me siento muy bien atendido en tiempos donde el buen servicio es escaso."
            />
            <CardTestimonios
                name="Alejandro"
                quote="Muy buena atención y profesionalidad."
            />
            <CardTestimonios
                name="Angela"
                quote="Me pareció un lugar super lindo para llevar al peque, lo trataron muy bien y el corte le quedó súper. Volvería."
            />
        </div>
    </div>
</section>