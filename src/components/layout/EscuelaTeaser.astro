---
import { ANALYTICS_EVENTS } from '../../lib/analytics';
---

<section id="escuela-teaser" class="w-full py-16 lg:py-24 bg-surface font-gothic border border-accentMuted rounded-2xl shadow-card" aria-label="Escuela Stylo's" data-analytics-section-view>
  <div class="max-w-4xl mx-auto px-4 text-center opacity-0" data-animate>
    <h2 class="font-bold text-3xl sm:text-4xl lg:text-5xl uppercase text-textLight mb-4">Escuela Stylo's</h2>
    <p class="text-lg sm:text-xl text-textMuted leading-relaxed mb-8 max-w-2xl mx-auto">
      Formación práctica en barbería desde cero. Aprendé herramientas, técnica y oficio real en Ituzaingó.
    </p>
    <a href="/escuela"
      class="inline-block rounded-xl bg-accent px-8 py-4 text-center text-lg font-bold uppercase text-white transition-all duration-300 hover:bg-accentHover hover:shadow-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
      data-analytics-event={ANALYTICS_EVENTS.CLICK_CONOCER_ESCUELA}
    >
      Conocé la escuela
    </a>
  </div>
</section>
