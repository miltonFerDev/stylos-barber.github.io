<section id="elegi-cuando-venir" class="w-full py-12 lg:py-20 text-center font-gothic" aria-label="Elegí cuándo venir">
  <div class="max-w-6xl mx-auto px-4">
    <div class="mb-10 lg:mb-16 opacity-0" data-animate>
      <span class="text-accent text-xs font-semibold tracking-widest uppercase mb-3 block">Horarios</span>
      <h2 class="font-bold text-3xl sm:text-4xl lg:text-5xl xl:text-6xl uppercase text-textLight">Elegí cuándo venir</h2>
      <div class="w-12 h-1 bg-accent rounded-full mx-auto mt-4"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8 opacity-0" data-animate style="animation-delay: 100ms">
      <div class="group relative bg-cardBgSoft rounded-2xl p-8 lg:p-10 transition-all duration-300 hover:shadow-cardHover hover:-translate-y-1 text-left">
        <h3 class="text-xl lg:text-2xl font-semibold text-textLight pb-2 lg:pb-3">Mañana</h3>
        <p class="text-base lg:text-lg text-textMuted leading-relaxed">Más tranquilo. Hasta las 11, café de especialidad incluido con tu corte.</p>
      </div>

      <div class="group relative bg-cardBgSoft rounded-2xl p-8 lg:p-10 transition-all duration-300 hover:shadow-cardHover hover:-translate-y-1 text-left">
        <h3 class="text-xl lg:text-2xl font-semibold text-textLight pb-2 lg:pb-3">Mediodía</h3>
        <p class="text-base lg:text-lg text-textMuted leading-relaxed">Ideal para resolver el corte durante el día.</p>
      </div>

      <div class="group relative bg-cardBgSoft rounded-2xl p-8 lg:p-10 transition-all duration-300 hover:shadow-cardHover hover:-translate-y-1 text-left">
        <h3 class="text-xl lg:text-2xl font-semibold text-textLight pb-2 lg:pb-3">Viernes y sábado</h3>
        <p class="text-base lg:text-lg text-textMuted leading-relaxed">Mayor demanda. Conviene reservar con anticipación.</p>
      </div>
    </div>
  </div>
</section>
