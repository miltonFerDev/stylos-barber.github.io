---
import '@fontsource/gothic-a1';
---

<div id="donde-estamos" class="w-full py-16 lg:py-28 font-gothic" aria-label="Ubicación y horarios">
    <div class="max-w-3xl mx-auto px-4 mb-16 lg:mb-24 text-center">
        <div class="relative" id="mision-container">
            <svg class="w-6 h-6 sm:w-8 sm:h-8 mx-auto mb-6 text-accent opacity-50" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
            </svg>

            <p class="text-base sm:text-lg md:text-xl lg:text-2xl text-textMuted italic leading-relaxed mission-text">
                Nuestra misión es proporcionar cortes de cabello de calidad en tiempos eficientes, sin comprometer la experiencia del cliente, en un ambiente profesional y amigable.
            </p>

            <p class="mt-6 text-xs sm:text-sm md:text-base text-accent font-semibold tracking-wider mission-attribution">
                — Stylo's Barber
            </p>
        </div>
    </div>

    <div class="max-w-6xl mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
            <div class="flex flex-col items-center text-center lg:items-start lg:text-left gap-4 lg:gap-6">
                <h3 class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl uppercase font-bold text-textLight">Encontranos</h3>
                <div class="flex flex-col gap-3 text-base sm:text-lg lg:text-xl text-textMuted">
                    <p class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                        </svg>
                        Soler 398, esquina Lavalle, Ituzaingó
                    </p>
                    <p class="flex items-center gap-2">
                        <svg class="w-5 h-5 text-accent shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                        Martes a Sábado de 9:30 a 20 hs.
                    </p>
                </div>
            </div>

            <iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3281.9307212144267!2d-58.67314667304684!3d-34.656452499999986!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95bcbf609e9d19df%3A0x71a8e1d95bd46dfc!2sStylos%20Barber!5e0!3m2!1ses-419!2sar!4v1726241389255!5m2!1ses-419!2sar"
                class="w-full h-[300px] sm:h-[350px] lg:h-[400px] rounded-2xl shadow-mapa border border-accentMuted"
                allowfullscreen=""
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Ubicación de Stylo's Barber en el mapa"
            ></iframe>
        </div>
    </div>
</div>

<style>
    @keyframes slideReveal {
        0% {
            opacity: 0;
            transform: translateY(12px) blur(3px);
        }
        100% {
            opacity: 1;
            transform: translateY(0) blur(0);
        }
    }

    .mission-text .char {
        opacity: 0;
        animation: slideReveal 0.5s ease-out forwards;
    }

    .mission-attribution {
        opacity: 0;
        animation: slideReveal 0.5s ease-out 2.5s forwards;
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const container = document.getElementById('mision-container');
        if (!container) return;

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const textEl = container.querySelector('.mission-text');
                    if (textEl && !textEl.dataset.animated) {
                        textEl.dataset.animated = 'true';
                        const text = textEl.textContent;
                        const chars = text.split('');
                        let html = '';
                        chars.forEach((char, i) => {
                            if (char === ' ') {
                                html += ' ';
                            } else {
                                html += `<span class="char" style="animation-delay: calc(${i} * 20ms + 100ms)">${char}</span>`;
                            }
                        });
                        textEl.innerHTML = html;
                    }
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.2 });

        observer.observe(container);
    });
</script>
