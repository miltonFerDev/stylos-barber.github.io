---
interface Props {
  buttonText: string;
  buttonLink: string;
  classString: string;
}

const { buttonText = "Quiero un turno", buttonLink = "#", classString = "inline-block text-center text-[16px] sm:text-[24px] py-4 w-full max-w-[400px] bg-[#3E52D5] hover:bg-[#586DF3] transition-colors rounded-xl text-white font-extrabold uppercase absolute bottom-10 focus:outline-none focus:ring-2 focus:ring-white/70 focus:ring-offset-2 focus:ring-offset-[#242331] shadow-lf shadow-black/20"} = Astro.props;
---

<a  onclick="gtag('event', 'click:turno', { event_category: 'conversion'});"
href={buttonLink} target="_blank" class={classString}>
{buttonText}
</a>