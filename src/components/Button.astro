---
interface Props {
  buttonText: string;
  buttonLink: string;
  classString: string;
  eventName?: string;
}

const { buttonText = "Quiero un turno", buttonLink = "#", classString = "inline-block text-center py-3 px-6 rounded-xl transition-colors duration-200", eventName = "click:turno" } = Astro.props;
---

<a onclick={`if(typeof gtag==='function')gtag('event','${eventName}',{event_category:'conversion'});`}
href={buttonLink} target="_blank" class={classString}>
{buttonText}
</a>