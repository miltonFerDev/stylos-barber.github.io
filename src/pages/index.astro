---
import Navigation from "../components/layout/Navigation.astro";
import Hero from "../components/layout/Hero.astro";
import DondeEstamos from "../components/layout/DondeEstamos.astro";
import Servicios from "../components/layout/Servicios.astro";
import Testimonios from "../components/layout/Testimonios.astro";
import Footer from "../components/layout/Footer.astro";
---

<html lang="es" class="scroll-smooth">
	<head>
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-VW2HRJZDZ8"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', 'G-VW2HRJZDZ8'); // Reemplazá con tu ID real
</script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />

		<title>
			Stylo's Barber - Calidad y calidez al servicio de tu cabello
		</title>

		<meta
			name="description"
			content="Vení a Stylo's Barber en Ituzaingó. Cortes clásicos, modernos, fades, diseño de barba y más. Atención personalizada y técnica de primera. Reservá tu turno."
		/>
		<meta name="generator" content={Astro.generator} />
		<meta property="og:title" content="Stylo’s Barber" />
		<meta
			property="og:description"
			content="Barbería en Ituzaingó. Reservá tu turno online."
		/>
		<meta
			property="og:image"
			content="https://stylosbarber.com.ar/og-image.png"
		/>
		<meta property="og:url" content="https://stylosbarber.com.ar" />
		<meta property="og:type" content="website" />
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "HairSalon",
				"name": "Stylo’s Barber",
				"image": "https://stylosbarber.com.ar/og-image.jpg",
				"url": "https://stylosbarber.com.ar",
				"telephone": "+549XXXXXXXXXX",

				"address": {
					"@type": "PostalAddress",
					"streetAddress": "General Miguel Soler 398",
					"addressLocality": "Ituzaingó",
					"addressCountry": "AR"
				},

				"geo": {
					"@type": "GeoCoordinates",
					"latitude": -34.65,
					"longitude": -58.67
				},

				"openingHoursSpecification": [
					{
						"@type": "OpeningHoursSpecification",
						"dayOfWeek": [
							"Tuesday",
							"Wednesday",
							"Thursday",
							"Friday",
							"Saturday"
						],
						"opens": "09:30",
						"closes": "20:00"
					}
				],

				"priceRange": "$$",

				"areaServed": {
					"@type": "Place",
					"name": "Ituzaingó"
				},

				"sameAs": ["https://instagram.com/stylosbarber"]
			}
		</script>
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const observer = new IntersectionObserver((entries) => {
					entries.forEach(entry => {
						if (entry.isIntersecting) {
							entry.target.classList.add('animate-fadeUp');
							entry.target.style.opacity = '1';
							observer.unobserve(entry.target);
						}
					});
				}, { threshold: 0.1 });

				document.querySelectorAll('[data-animate]').forEach(el => observer.observe(el));
			});
		</script>
	</head>
	<header>
		<Navigation />
	</header>

	<Hero />
	<main class="text-textFooter flex flex-col items-center">
		<div class="w-full bg-[#2A2A3D]">
			<Servicios />
		</div>
		<div class="w-full bg-primary">
			<Testimonios />
		</div>
		<div class="w-full bg-primary">
			<DondeEstamos />
		</div>
	</main>
	<footer>
		<Footer />
	</footer>


</html>
