---
import { ProdeShell } from '../../prode/components/layout/ProdeShell';
import '../../styles/global.css';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';

export function getStaticPaths() {
  return [
    { params: { path: 'admin' } },
    { params: { path: 'fixture' } },
    { params: { path: 'predicciones' } },
    { params: { path: 'ranking' } },
    { params: { path: 'reglas' } },
    { params: { path: 'onboarding' } },
  ];
}
---

<html lang="es" class="scroll-smooth">
  <head>
    <GoogleAnalytics sendPageView={false} />
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://stylosbarber.com.ar/prode" />
    <meta name="theme-color" content="#0f0f0f" />
    <title>Prode Mundial 2026 · Stylo's Barber</title>
    <meta name="description" content="Participá del Prode del Mundial 2026 en Stylo's Barber. Hacé tus predicciones, competí en el ranking y ganá premios." />
    <meta property="og:title" content="Prode Mundial 2026 · Stylo's Barber" />
    <meta property="og:description" content="Hacé tus predicciones, competí en el ranking y ganá premios del Mundial 2026." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://stylosbarber.com.ar/prode" />
    <meta property="og:site_name" content="Stylo's Barber" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Prode Mundial 2026 · Stylo's Barber" />
    <meta name="twitter:description" content="Hacé tus predicciones, competí en el ranking y ganá premios del Mundial 2026." />
  </head>
  <body>
    <ProdeShell client:only="react" />
  </body>
</html>
