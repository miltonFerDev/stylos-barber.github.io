---
import { ProdeShell } from '../../prode/components/layout/ProdeShell';
import '../../styles/global.css';
import GoogleAnalytics from '../../components/GoogleAnalytics.astro';

export function getStaticPaths() {
  return [
    { params: { path: 'admin' } },
    { params: { path: 'fixture' } },
    { params: { path: 'predicciones' } },
    { params: { path: 'ranking' } },
    { params: { path: 'reglas' } },
    { params: { path: 'onboarding' } },
    { params: { path: 'login' } },
    { params: { path: 'signup' } },
    { params: { path: 'reset-password' } },
  ];
}
---

<html lang="es" class="scroll-smooth">
  <head>
    <GoogleAnalytics sendPageView={true} />
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://stylosbarber.com.ar/prode" />
    <meta name="theme-color" content="#0f0f0f" />
    <title>Resultados finales del Prode Mundial 2026 · Stylo's Barber</title>
    <meta name="description" content="El Mundial 2026 terminó. Mirá la tabla general final, los aciertos perfectos y parciales, y las estadísticas del Prode de Stylo's Barber." />
    <meta property="og:title" content="Resultados finales del Prode Mundial 2026 · Stylo's Barber" />
    <meta property="og:description" content="El Mundial 2026 terminó. Mirá los resultados finales del Prode de Stylo's Barber: tabla general, aciertos perfectos y parciales." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://stylosbarber.com.ar/prode" />
    <meta property="og:site_name" content="Stylo's Barber" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Resultados finales del Prode Mundial 2026 · Stylo's Barber" />
    <meta name="twitter:description" content="El Mundial 2026 terminó. Mirá los resultados finales del Prode de Stylo's Barber." />
  </head>
  <body>
    <ProdeShell client:only="react" />
  </body>
</html>